		 "clickSelector": "#toggle",
		 "targetSelector": "#toggle",
		 "expectHasClass": "active"
	  }
	],
	"solution": "const button = document.querySelector('#toggle');\nbutton?.addEventListener('click', () => {\n  button.classList.toggle('active');\n});"
